# Copy values into your shell environment (Django does not read .env files itself).
# Windows cmd:  set DJANGO_DEBUG=1
# macOS/Linux:  export DJANGO_DEBUG=1

DJANGO_DEBUG=0                       # 1 only for local development
DJANGO_SECRET_KEY=change-me          # required for real deployments
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE=0                      # 1 behind HTTPS: redirect, HSTS, secure cookies
DJANGO_LOG_LEVEL=INFO
MAX_UPLOAD_MB=50
MAX_UNCOMPRESSED_MB=500
# DJANGO_DB_PATH=/data/db.sqlite3
# DJANGO_MEDIA_ROOT=/data/media
